 extern "C" int juce_gtkWebkitMain (int argc, const char* const* argv);
 
+enum class WebKitHardwareAccelerationPolicy
+{
+    onDemand = 0,
+    always = 1,
+    never = 2
+};
+
+#define JUCE_WEBKIT_HARDWARE_ACCELERATION_POLICY_ON_DEMAND 0
+#define JUCE_WEBKIT_HARDWARE_ACCELERATION_POLICY_ALWAYS 1
+#define JUCE_WEBKIT_HARDWARE_ACCELERATION_POLICY_NEVER 2
+
+#ifndef JUCE_WEBKIT_HARDWARE_ACCELERATION_POLICY
+ #define JUCE_WEBKIT_HARDWARE_ACCELERATION_POLICY JUCE_WEBKIT_HARDWARE_ACCELERATION_POLICY_NEVER
+#endif
+
+static constexpr auto configuredWebKitHardwareAccelerationPolicy =
+    static_cast<WebKitHardwareAccelerationPolicy> (JUCE_WEBKIT_HARDWARE_ACCELERATION_POLICY);
+
+static_assert (configuredWebKitHardwareAccelerationPolicy >= WebKitHardwareAccelerationPolicy::onDemand
+               && configuredWebKitHardwareAccelerationPolicy <= WebKitHardwareAccelerationPolicy::never);
+
+static const char* getWebKitHardwareAccelerationPolicyName (WebKitHardwareAccelerationPolicy policy)
+{
+    switch (policy)
+    {
+        case WebKitHardwareAccelerationPolicy::onDemand: return "on-demand";
+        case WebKitHardwareAccelerationPolicy::always:   return "always";
+        case WebKitHardwareAccelerationPolicy::never:    return "never";
+    }
+
+    jassertfalse;
+    return "unknown";
+}
+
